################################################################################
# StudentOS — environment
#
# Every variable the product reads. `src/services/env.ts` is the only file that
# touches process.env, so if a name is in one of these two files and not the
# other, one of them is wrong.
#
# You almost never fill this in by hand. On a machine that is set up, the
# working copy of this file comes from Vercel:
#
#     vercel link                  # once per machine
#     vercel env pull .env.local   # writes the real values
#
# To go the other way, `scripts/env-push.sh` reads a local .env.local and puts
# each name into Vercel, prompting for the value rather than echoing it.
#
# ---------------------------------------------------------------------------
# HOW TO READ THIS FILE
#
# Every variable carries two annotations:
#
#   # env:  which Vercel environments need it — production, preview, development
#   # from: where the value comes from, by name and dashboard
#
# "development" means a developer's own .env.local, not a Vercel environment
# that ships anything.
#
# ---------------------------------------------------------------------------
# THE INDEX
#
#   NAME                              PROD  PREV  DEV   NEEDED FOR
#   NEXT_PUBLIC_SUPABASE_URL           ✓     ✓     -    durable storage
#   NEXT_PUBLIC_SUPABASE_ANON_KEY      ✓     ✓     -    browser-side Supabase
#   SUPABASE_SERVICE_ROLE_KEY          ✓     ✓     -    durable storage
#   SUPABASE_PROJECT_REF               -     -     ✓    `supabase link` in bootstrap
#   STUDENTOS_STORE                    ✓     -     -    fail loudly, never silently
#   NEXT_PUBLIC_SITE_URL               ✓     -     -    share links, sitemap
#   CRON_SECRET                        ✓     ✓     -    scheduled routes
#   RESEND_API_KEY                     ✓     -     -    verification and reset mail
#   RESEND_FROM                        ✓     -     -    the From address
#   ADMIN_EMAILS                       ✓     ✓     ✓    who reaches /admin
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY ✓     -     -    checkout
#   STRIPE_SECRET_KEY                  ✓     -     -    checkout
#   STRIPE_WEBHOOK_SECRET              ✓     -     -    granting entitlements
#   STRIPE_PRICE_* (six)               ✓     -     -    what each plan costs
#   ANTHROPIC_API_KEY                  ✓     -     -    fluent explanations
#   GOOGLE_CLIENT_ID / _SECRET         ✓     -     -    Google sign-in
#   MAPS_API_KEY                       ✓     -     -    the Discover map
#   NEXT_PUBLIC_SENTRY_DSN             ✓     ✓     -    seeing crashes
#   NEXT_PUBLIC_POSTHOG_KEY            ✓     -     -    product analytics
#   STUDENTOS_WORK_FEEDS               ✓     -     -    job feeds, none yet
#   STUDENTOS_CONTENT_MODE             ✓     -     -    dropping the sample notice
#   STUDENTOS_DEMO_PASSWORD            -     -     ✓    the local demo account
#   STUDENTOS_DATA_DIR                 -     -     ✓    set by the e2e config
#
# Nothing above is required to build. The build, the unit tests and the
# Playwright flows all run with every one of these unset, which is what lets CI
# and a preview deploy work with no secrets at all.
################################################################################


################################################################################
# REQUIRED FOR LAUNCH
################################################################################

# ---- Where the data lives ----------------------------------------------------
# Without BOTH the URL and the service role key the application runs on a JSON
# file. On Vercel that file is on the instance's temp disk and every redeploy
# deletes every account.
#
# The anon key is not part of that test on purpose: the store is reached only
# from the server, only with the service role key. Set the anon key anyway —
# Supabase Auth and any future browser-side use need it.
#
# Apply supabase/migrations/0005_row_store.sql and 0006_scheduled_cleanup.sql
# before deploying (NOT 0001 to 0004, see PRODUCTION_SETUP.md), then run
# `pnpm db:verify` to prove the connection actually works.
#
# env:  production, preview
# from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The project ref, which is the subdomain of the URL above. `scripts/bootstrap.sh`
# reads it to run `supabase link` without asking. Not a secret and not read by
# the application.
#
# env:  development
# from: the middle of NEXT_PUBLIC_SUPABASE_URL
SUPABASE_PROJECT_REF=

# Forces the store instead of inferring it. Set this to `supabase` in
# production: a missing variable then fails the boot loudly instead of quietly
# serving a database that the next deploy deletes.
# One of: file | supabase
#
# env:  production
# from: you. It is a declaration, not a credential.
STUDENTOS_STORE=

# ---- Who the site is ---------------------------------------------------------
# Share links, the sitemap, robots.txt and the Google OAuth callback all read
# this. Wrong here means every share link points somewhere else.
#
# Deliberately NOT set on preview: a preview with this set inherits production's
# domain and emits share links pointing at the live site. Unset, the code falls
# back to VERCEL_URL, so a preview describes itself correctly.
#
# env:  production
# from: your custom domain, or the Vercel production URL until you have one
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Scheduled routes --------------------------------------------------------
# Vercel Cron sends this as `Authorization: Bearer <value>` to every route under
# /api/cron. Unset means those routes refuse every request, which is the safe
# resting state: a cron endpoint anyone can trigger is a way to make the product
# do work on demand.
#
# Generate one with: openssl rand -base64 32
#
# env:  production, preview
# from: you. Any long random string; nothing else has to know it.
CRON_SECRET=

# ---- Email -------------------------------------------------------------------
# While RESEND_API_KEY is unset the app shows the verification link ON SCREEN
# instead of sending it, which means anyone can verify any address. This is a
# launch blocker, not a nice-to-have.
# The domain in RESEND_FROM must be verified in Resend with SPF, DKIM and DMARC.
#
# env:  production
# from: Resend dashboard → API Keys, and a domain you have verified there
RESEND_API_KEY=
RESEND_FROM=StudentOS <hello@your-domain.com>

# ---- Who can reach /admin ----------------------------------------------------
# Comma-separated. Kept in the environment rather than as a database flag on
# purpose: promoting yourself to admin should require a deploy, not a row edit.
#
# env:  production, preview, development
# from: you
ADMIN_EMAILS=you@your-domain.com

# ---- Payments ----------------------------------------------------------------
# Entitlements are enforced server-side from the subscription row, so a missing
# Stripe config means nobody can pay — not that everybody gets everything.
# The webhook is the ONLY thing that grants an entitlement, and it refuses
# unsigned requests with no development bypass.
#
# env:  production
# from: Stripe dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# From Stripe → Developers → Webhooks, after adding an endpoint at
# https://<your-domain>/api/stripe/webhook. It is per endpoint, so the value for
# `stripe listen` in local development is a different one and belongs only in
# your own .env.local.
#
# env:  production
# from: the endpoint's signing secret, shown once when you create it
STRIPE_WEBHOOK_SECRET=

# All six. A missing one fails that plan's checkout loudly rather than charging
# the wrong amount. `/admin` → Services names any that are missing.
#
# env:  production
# from: Stripe dashboard → Product catalogue → each price's ID
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=


################################################################################
# OPTIONAL
################################################################################

# ---- AI ----------------------------------------------------------------------
# The product is complete without a model. Every surface has a deterministic
# path, and a key only makes explanations more fluent. Nothing invents a price,
# an opening hour or a legal requirement whether or not this is set.
#
# ANTHROPIC_API_KEY alone is enough — it implies AI_PROVIDER=anthropic.
#
# env:  production
# from: console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic          # anthropic | openai | none
# AI_API_KEY=                    # for the OpenAI-compatible path; wins over ANTHROPIC_API_KEY
# AI_BASE_URL=                   # self-hosted or gateway endpoint, OpenAI shape

# Per-tier models. Tier 1 is classification and tagging, tier 2 ordinary work,
# tier 3 the rare deep plan. Defaults are in src/config/ai.ts and are current.
# AI_SMALL_MODEL=claude-haiku-4-5-20251001
# AI_DEFAULT_MODEL=claude-sonnet-5
# AI_PLANNING_MODEL=claude-opus-5
# AI_MODEL=                      # pins one model across every tier; the per-tier names win

# Ceilings. The euro spend caps live in /admin (defaults €12/day, €200/month).
# These are the per-call and per-student limits.
# AI_MAX_TOKENS=1024
# AI_DAILY_LIMIT_FREE=20
# AI_DAILY_LIMIT_PLUS=60
# AI_DAILY_LIMIT_PRO=120
# AI_DAILY_LIMIT_MAX=300

# ---- Google sign-in ----------------------------------------------------------
# Without these the Google button is hidden and email sign-in still works.
# Redirect URI to register: https://your-domain.com/api/auth/google/callback
#
# env:  production
# from: Google Cloud console → APIs and services → Credentials → OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Maps --------------------------------------------------------------------
# Restrict the key by HTTP referrer and enable only the APIs Discover uses.
#
# env:  production
# from: Google Cloud console → Credentials → API key
# NEXT_PUBLIC_MAPS_PROVIDER=google
# MAPS_API_KEY=

# ---- Observability -----------------------------------------------------------
# Without Sentry, a crash in production is only visible if somebody reports it.
# Worth setting on preview too: a crash you find before merging is free.
#
# env:  production, preview
# from: Sentry → Project settings → Client keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Analytics. Never send transaction descriptions, home locations, chat contents
# or CV text into this.
#
# env:  production
# from: PostHog → Project settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ---- Work feeds --------------------------------------------------------------
# The ONLY way an external job source can enter the product, as a comma-
# separated list of slug=https://... pairs. There is no scraper and no crawler:
# a site that has not published a feed has not agreed to be republished.
#
# Read by /api/cron/work-sync, which runs daily. Unset everywhere today, and the
# cron route reports zero configured providers rather than pretending to sync.
#
# env:  production
# from: a partner who has published a feed. There are none yet.
# STUDENTOS_WORK_FEEDS=partner=https://example.org/jobs.json

# ---- Content -----------------------------------------------------------------
# `sample` (the default) keeps the standing "sample city data" notice on every
# page. Set to `real` only after reviewing the cities and replacing the seeded
# events, deals and places with real ones. Connecting a database does not make
# an invented event real, which is why this is a separate declaration.
# One of: sample | real
#
# env:  production
# from: you, after actually reviewing the content
STUDENTOS_CONTENT_MODE=sample


################################################################################
# DEVELOPMENT ONLY — must be unset in production
################################################################################

# Seeds demo@studentos.local with a full account and this password. There is
# deliberately no default: a seeded account with a known credential is a real
# account with a published password.
#
# env:  development
# from: you. `pnpm setup` writes `demo-local` into a fresh .env.local.
STUDENTOS_DEMO_PASSWORD=

# Points the JSON file store somewhere else. The e2e suite sets this so a test
# run never touches development data.
#
# env:  development
# from: playwright.config.ts sets it; you should not need to
# STUDENTOS_DATA_DIR=
