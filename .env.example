################################################################################
# StudentOS — environment
#
# Copy to .env.local for development. Set the same names in the Vercel project
# for production. Never commit a filled-in copy: .env.local is gitignored, this
# file is not.
#
# Every variable the product reads is listed here, and `src/services/env.ts` is
# the only file that reads process.env — if a name appears there and not here,
# one of the two is wrong.
#
# Three sections:
#   REQUIRED FOR LAUNCH   the product is not safe in front of the public without
#   OPTIONAL              the product works without; each says what is lost
#   DEVELOPMENT ONLY      must be unset in production
################################################################################


################################################################################
# REQUIRED FOR LAUNCH
################################################################################

# ---- Where the data lives ----------------------------------------------------
# Without BOTH of these the application runs on a JSON file. On Vercel that file
# is on the instance's temp disk and every redeploy deletes every account.
#
# The anon key is not part of that test on purpose: the store is reached only
# from the server, only with the service role key. Set the anon key anyway —
# Supabase Auth and any future browser-side use need it.
#
# Apply supabase/migrations/0005_row_store.sql before deploying, then run
# `pnpm db:verify` to prove the connection actually works.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Forces the store instead of inferring it. Set this to `supabase` in
# production: a missing variable then fails the boot loudly instead of quietly
# serving a database that the next deploy deletes.
# One of: file | supabase
STUDENTOS_STORE=

# ---- Who the site is ---------------------------------------------------------
# Share links, the sitemap, robots.txt and the Google OAuth callback all read
# this. Wrong here means every share link points somewhere else.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Email -------------------------------------------------------------------
# While RESEND_API_KEY is unset the app shows the verification link ON SCREEN
# instead of sending it, which means anyone can verify any address. This is a
# launch blocker, not a nice-to-have.
# The domain in RESEND_FROM must be verified in Resend with SPF, DKIM and DMARC.
RESEND_API_KEY=
RESEND_FROM=StudentOS <hello@your-domain.com>

# ---- Who can reach /admin ----------------------------------------------------
# Comma-separated. Kept in the environment rather than as a database flag on
# purpose: promoting yourself to admin should require a deploy, not a row edit.
ADMIN_EMAILS=you@your-domain.com

# ---- Payments ----------------------------------------------------------------
# Entitlements are enforced server-side from the subscription row, so a missing
# Stripe config means nobody can pay — not that everybody gets everything.
# The webhook is the ONLY thing that grants an entitlement, and it refuses
# unsigned requests with no development bypass.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# All six. A missing one fails that plan's checkout loudly rather than charging
# the wrong amount. `/admin` → Services names any that are missing.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=


################################################################################
# OPTIONAL
################################################################################

# ---- AI ----------------------------------------------------------------------
# The product is complete without a model. Every surface has a deterministic
# path, and a key only makes explanations more fluent. Nothing invents a price,
# an opening hour or a legal requirement whether or not this is set.
#
# ANTHROPIC_API_KEY alone is enough — it implies AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic          # anthropic | openai | none
# AI_API_KEY=                    # for the OpenAI-compatible path; wins over ANTHROPIC_API_KEY
# AI_BASE_URL=                   # self-hosted or gateway endpoint, OpenAI shape

# Per-tier models. Tier 1 is classification and tagging, tier 2 ordinary work,
# tier 3 the rare deep plan. Defaults are in src/config/ai.ts and are current.
# AI_SMALL_MODEL=claude-haiku-4-5-20251001
# AI_DEFAULT_MODEL=claude-sonnet-5
# AI_PLANNING_MODEL=claude-opus-5
# AI_MODEL=                      # pins one model across every tier; the per-tier names win

# Ceilings. The euro spend caps live in /admin (defaults €12/day, €200/month).
# These are the per-call and per-student limits.
# AI_MAX_TOKENS=1024
# AI_DAILY_LIMIT_FREE=20
# AI_DAILY_LIMIT_PLUS=60
# AI_DAILY_LIMIT_PRO=120
# AI_DAILY_LIMIT_MAX=300

# ---- Google sign-in ----------------------------------------------------------
# Without these the Google button is hidden and email sign-in still works.
# Redirect URI to register: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Maps --------------------------------------------------------------------
# Restrict the key by HTTP referrer and enable only the APIs Discover uses.
# NEXT_PUBLIC_MAPS_PROVIDER=google
# MAPS_API_KEY=

# ---- Observability -----------------------------------------------------------
# Without Sentry, a crash in production is only visible if somebody reports it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Analytics. Never send transaction descriptions, home locations, chat contents
# or CV text into this.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ---- Work feeds --------------------------------------------------------------
# The ONLY way an external job source can enter the product, as a comma-
# separated list of slug=https://... pairs. There is no scraper and no crawler:
# a site that has not published a feed has not agreed to be republished.
# STUDENTOS_WORK_FEEDS=partner=https://example.org/jobs.json

# ---- Content -----------------------------------------------------------------
# `sample` (the default) keeps the standing "sample city data" notice on every
# page. Set to `real` only after reviewing the cities and replacing the seeded
# events, deals and places with real ones. Connecting a database does not make
# an invented event real, which is why this is a separate declaration.
# One of: sample | real
STUDENTOS_CONTENT_MODE=sample


################################################################################
# DEVELOPMENT ONLY — must be unset in production
################################################################################

# Seeds demo@studentos.local with a full account and this password. There is
# deliberately no default: a seeded account with a known credential is a real
# account with a published password.
STUDENTOS_DEMO_PASSWORD=

# Points the JSON file store somewhere else. The e2e suite sets this so a test
# run never touches development data.
# STUDENTOS_DATA_DIR=
