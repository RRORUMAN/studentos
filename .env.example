# =============================================================================
# StudentOS — environment
# -----------------------------------------------------------------------------
# Every one of these is optional. With none of them set the product runs fully:
# a JSON-backed database seeded with sample city content, deterministic AI
# answers, and no billing. That is deliberate — nothing about the product should
# require a vendor account to evaluate.
#
# What each one turns on is written next to it. `docs/configuration.md` has the
# dashboard steps, the callback URLs and where to find each credential.
# =============================================================================

# Canonical URL, for share links, the sitemap and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# SUPABASE — swaps the JSON store for Postgres and turns off the "sample data"
# notice. Run every file in supabase/migrations/ in order; they carry the RLS
# policies the JSON store cannot express.
#
# REQUIRED FOR PRODUCTION. Without it the store is a JSON file on the instance's
# disk, which on a serverless host is wiped on every restart.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never referenced from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI — without a key the gateway uses its deterministic provider, and every
# surface still works. A key only makes the *explanations* more fluent; it never
# changes which places or events are selected, and it can never invent one.
#
# Provider, per-tier model, temperature, token ceilings and spend caps are all
# editable from /admin without a deploy. The API key is not, on purpose.
# -----------------------------------------------------------------------------
# "anthropic" (default), "openai" for any OpenAI-compatible endpoint, or "none".
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional. Pins one model across every tier; leave unset to use the per-tier
# defaults (Haiku for tier 1, Sonnet for tier 2, Opus for tier 3 on Max).
AI_MODEL=
# Optional. For self-hosted or proxied OpenAI-compatible gateways.
AI_BASE_URL=

# -----------------------------------------------------------------------------
# STRIPE — until these are set, the upgrade screen says billing is not connected
# rather than showing a button that does nothing.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Required. The webhook refuses unsigned requests, with no development bypass.
STRIPE_WEBHOOK_SECRET=

# Price ids. The checkout reads these; a client can never supply one.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_ANNUAL=

# -----------------------------------------------------------------------------
# GOOGLE SIGN-IN — until both are set, the sign-in screens say Google is not
# connected rather than showing a button that fails. Create an OAuth client of
# type "Web application" and add this redirect URI:
#   https://<your-host>/api/auth/google/callback   (and http://localhost:3000/... for dev)
# With Supabase Auth in front, use its provider settings instead and point the
# Supabase callback at https://<project>.supabase.co/auth/v1/callback.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# EMAIL — without a key, verification and reset links are surfaced in the
# redirect instead of emailed. That path is gated on this being unset, so
# setting a key is what closes it.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=

# -----------------------------------------------------------------------------
# ANALYTICS AND MONITORING — both no-op when unset.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=

# -----------------------------------------------------------------------------
# MAPS — Discover renders from our own rows with no third-party tiles by
# default, so nothing about where a student looks is sent anywhere. A key opts
# into a tile provider for signed-in product surfaces only.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAPS_PROVIDER=
MAPS_API_KEY=

# -----------------------------------------------------------------------------
# ADMIN — comma-separated addresses granted the admin surface. In the
# environment rather than a database flag, so promoting an admin takes a deploy.
# -----------------------------------------------------------------------------
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# DEMO ACCOUNT — when set, the seeder creates a fully populated student at
# demo@studentos.local with this password: budget, transactions, a timeline, a
# mission in progress, friends, plans, saved places and exchange listings.
#
# There is deliberately NO DEFAULT. A seeded account with a known credential is
# a real account with a published password, and it should exist only where
# somebody chose to create it. NEVER set this in production.
# -----------------------------------------------------------------------------
# STUDENTOS_DEMO_PASSWORD=

# -----------------------------------------------------------------------------
# TESTING — points the JSON store at a throwaway directory. Set by the
# Playwright config; you should not need it by hand. Unset, the store uses
# .data/ locally, or the OS temp directory on a serverless host (where the app
# shows a standing "nothing is kept" notice until a database is connected).
# -----------------------------------------------------------------------------
# STUDENTOS_DATA_DIR=.data/e2e
