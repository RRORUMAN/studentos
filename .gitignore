# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data store
# The JSON-backed fallback database. Development data is personal, and the e2e
# subdirectory is recreated on every test run.
/.data/

# playwright
# Also keeps Tailwind's source scanner out of these: the artifacts contain
# Windows extended-length paths (\?\C:\...) that Turbopack refuses to walk.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Supabase CLI
/supabase/.temp/
/supabase/.branches/

# logs
*.log

# editors and operating systems
Thumbs.db
.idea/

# build caches
.turbo/
